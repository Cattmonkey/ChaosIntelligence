import "behavior.chaos" as Behavior;

fn policy() {
  team_from({kind:"team",name:"callable dot roles",entry:"programmer",roles:[
    {id:"programmer",parent:null,capabilities:["session.manage"],agent:{kind:"agent",name:"programmer",config:{provider:"model",route:"programmer",role:"planner",tools:[],prompt:"Call program_snapshot for the exact Program and requested increment. Return a complete Program JSON definition changing behavior.answer to add that increment; preserve other modules and dialects."}}},
    {id:"reviewer",parent:"programmer",capabilities:["session.manage"],agent:{kind:"agent",name:"reviewer",config:{provider:"model",route:"reviewer",role:"reviewer",tools:[],prompt:"Call check_candidate to execute the candidate checks. Return JSON {approve: boolean, reason: string}."}}},
    {id:"check",parent:null,capabilities:[],agent:{kind:"agent",name:"check",config:{provider:"local",tools:[]}}}
  ]})
}

async fn step(ctx) {
  let state=ctx.state;
  let before=Behavior.answer(state.value);
  if state.generation>=state.iterations {
    process_step(merge(state,{lastObserved:before}),{value:before,version:ctx.programVersion},true)
  } else {
    let base=current_program();
    let team=policy();
    let definitions=team_info(team).roles;
    let programmer=await session_open("team_programmer",agent_from(definitions[0]["agent"]));
    let reviewer=await session_open("team_reviewer",agent_from(definitions[1]["agent"]));
    let requested=state.generation+2;
    let equipped=session_bind(programmer,[agent_tool("program_snapshot",fn(_:Null)->Record {
      {definition:program_info(base),increment:requested}
    },input_type="Null",output_type="Record")]);
    let planning=team_bind(team,{programmer:equipped});
    let message_id="generation_"+str(state.generation);
    let proposed=await planning({generation:state.generation},message_id=message_id);
    let candidate=program_from(parse_json(proposed.output));
    let cases=[{entry:"tests.chaos",input:state.value,expect:state.value+requested},{entry:"tests.chaos",input:0,expect:requested}];
    let checking=team_bind(team,{check:async fn(program:Program,cases:List)->Record {
      await program_probe(program,cases)
    }});
    let review_tools=session_bind(reviewer,[agent_tool("check_candidate",async fn(_:Null)->Record {
      await team_role(checking,"check")(candidate,cases)
    },input_type="Null",output_type="Record")]);
    let reviewing=team_bind(team,{reviewer:review_tools});
    let reviewed=await team_role(reviewing,"reviewer")({generation:state.generation},message_id=message_id);
    let decision=parse_json(reviewed.output);
    if !decision.approve {throw decision} else {null};
    process_evolve(base,candidate,cases,
      merge(state,{generation:state.generation+1,lastObserved:before}),{
        before:before,sameFunction:Behavior.answer(state.value),executedVersion:ctx.programVersion,
        programmerMessageId:proposed.messageId,reviewerMessageId:reviewed.messageId
      },reason="persistent roles compose actual functions under Team policy")
  }
}
export {step};
