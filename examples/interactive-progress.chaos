// Complete no-key tutorial. Run in the IDE or a POSIX terminal with --interactive.
// Input is null by default; use {waitSeconds: 0} for a noninteractive smoke run.
let wait_seconds = if input == null { 30 } else { input.waitSeconds };
await progress_emit("plan", {summary: "先计算三个平方，再等待一条运行指导"});
var squares = [];
for number in range(1, 4) {
  squares = append(squares, number * number);
  await progress_emit("progress", {
    summary: "已完成一项计算",
    completed: length(squares),
    total: 3,
    squares: squares
  });
  await sleep(0.25);
}
await progress_emit("plan", {
  summary: "请从运行面板追加指导；本例原样记录指导数据",
  waitSeconds: wait_seconds
});
let guidance = await guidance_receive(wait_seconds);
let received_input = if guidance.received { guidance.message.input } else { null };
await progress_emit("result", {
  summary: if guidance.received { "已接收指导，准备返回实际数据" } else { "等待结束，未收到指导" },
  received: guidance.received
});
{received: guidance.received, guidance: received_input, squares: squares}
