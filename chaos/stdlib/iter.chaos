}
fn azip(*sources) -> AsyncGenerator {
  (
    async fn*() {
      if length(sources) == 0 {
        return null
      } else {
        null
      };
      var cursors = [];
      var index = 0;
      while index < length(sources) {
        cursors = append(cursors, aiter(sources[index]));
        index = index + 1
      };
      while true {
        var row = [];
        index = 0;
        while index < length(cursors) {
          let step = await anext(cursors[index]);
          if step.done {
            return null
          } else {
            null
          };
          row = append(row, step.value);
          index = index + 1;
        };
        yield (tuple(row));
      }
    }
  )()
}
fn achain(*sources) -> AsyncGenerator {
  (
    async fn*() {
      var index = 0;
      while index < length(sources) {
        let cursor = aiter(sources[index]);
        while true {
          let step = await anext(cursor);
          if step.done {
            break
          } else {
            yield (step.value)
          };
        };
        index = index + 1;
      }
    }
  )()
}
fn abatches(source, size: Int) -> AsyncGenerator {
  checked_size(size);
  (
    async fn*() {
      let cursor = aiter(source);
      var chunk = [];
      while true {
        let step = await anext(cursor);
        if step.done {
          if length(chunk) > 0 {
            yield (tuple(chunk))
          } else {
            null
          };
          return null;
        } else {
          null
        };
        chunk = append(chunk, step.value);
        if length(chunk) == size {
          let batch = tuple(chunk);
          chunk = [];
          yield (batch)
        } else {
          null
        };
      }
    }
  )()
}
fn ascan(reducer: Function, initial, source) -> AsyncGenerator {
  checked_callback(reducer);
  (
    async fn*() {
      var accumulator = initial;
      yield (accumulator);
      let cursor = aiter(source);
      while true {
        let step = await anext(cursor);
        if step.done {
          return null
        } else {
          null
        };
        let produced = reducer(accumulator, step.value);
        let updated = if type_of(produced) == "Task" {
          await produced
        } else {
          produced
        };
        accumulator = updated;
        yield (accumulator);
      }
    }
  )()
}
fn from_sync(source) -> AsyncGenerator {
  (
    async fn*() {
      let cursor = iter(source);
      while true {
        let step = next(cursor);
        if step.done {
          return null
        } else {
          yield (step.value)
        };
      }
    }
  )()
}
fn count(start: Int = 0, step: Int = 1) -> Generator {
  (
    fn*() {
      var value = start;
      while true {
        yield (value);
        value = value + step
      }
    }
  )()
}
fn repeat(value, count = null) -> Generator {
  if type_of(count) == "Null" {
    null
  } else {
    checked_count(count)
  };
  (
    fn*() {
      var remaining = count;
      while remaining == null || remaining > 0 {
        yield (value);
        if remaining == null {
          null
        } else {
          remaining = remaining - 1
        };
      }
    }
  )()
}
