        };
        if dropping {
          null
        } else {
          yield (step.value)
        };
      }
    }
  )()
}
fn aenumerate(source, start: Int = 0) -> AsyncGenerator {
  (
    async fn*() {
      let cursor = aiter(source);
      var index = start;
      while true {
        let step = await anext(cursor);
        if step.done {
          return null
        } else {
          null
        };
        yield ((index, step.value));
