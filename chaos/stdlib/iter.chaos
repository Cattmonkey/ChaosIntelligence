        };
        let produced = predicate(step.value);
        let accepted = if type_of(produced) == "Task" {
          await produced
        } else {
          produced
        };
        if checked_bool(accepted) {
          yield (step.value)
        } else {
          null
        };
      }
    }
  )()
}
fn aflat_map(mapper: Function, source) -> AsyncGenerator {
  checked_callback(mapper);
  (
    async fn*() {
      let cursor = aiter(source);
      while true {
        let step = await anext(cursor);
        if step.done {
          return null
        } else {
          null
        };
        let produced = mapper(step.value);
        let items = if type_of(produced) == "Task" {
          await produced
        } else {
          produced
        };
        let nested = aiter(items);
        while true {
          let item = await anext(nested);
          if item.done {
            break
          } else {
            yield (item.value)
          };
        };
      }
    }
  )()
}
fn atake(source, count: Int) -> AsyncGenerator {
  checked_count(count);
  (
    async fn*() {
      if count == 0 {
        return null
      } else {
        null
      };
      let cursor = aiter(source);
      var remaining = count;
      while remaining > 0 {
        let step = await anext(cursor);
        if step.done {
          return null
        } else {
          null
        };
        remaining = remaining - 1;
        yield (step.value);
      }
    }
  )()
}
fn adrop(source, count: Int) -> AsyncGenerator {
  checked_count(count);
  (
    async fn*() {
      let cursor = aiter(source);
      var remaining = count;
      while remaining > 0 {
        let step = await anext(cursor);
        if step.done {
          return null
        } else {
          null
        };
        remaining = remaining - 1;
      };
      while true {
        let step = await anext(cursor);
        if step.done {
          return null
        } else {
          yield (step.value)
        };
      }
    }
  )()
}
